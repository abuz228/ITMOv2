{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent-2b",
  "small_model": "ollama/itmo-agent-2b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://172.22.192.1:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "itmo-agent-fast": {
          "name": "ITMO local fast 16k",
          "body": {
            "reasoning_effort": "none"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "itmo-agent-2b": {
          "name": "ITMO local 2B 16k",
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}